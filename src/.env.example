# FinAlly 환경변수 — 실제 값은 .env.local 에 넣습니다 (이 파일은 예시입니다)
#
# 정본: spec/common/08-14-api.md §1.2 · ARCHITECTURE.md §7
#
#   cp .env.example .env.local   후 값을 채웁니다
#
# **비밀 값을 코드나 설정 파일에 넣지 않습니다.** .env.local 은 .gitignore 에 걸려 있습니다.
# **평문 비밀번호는 환경변수에도 넣지 않습니다** — 관리자 비밀번호는 해시만 둡니다.
#
# 값은 저장소 밖에서 옵니다 → ADR-059 (저장소 공개). 프로덕션은 **Vercel env 가 정본**
# (대시보드 → Settings → Environment Variables). 로컬 값은 소유자에게 직접 받습니다 —
# Hobby 팀이라 `vercel env pull` 은 팀원이 못 씁니다. 2026-08-24~27 에 .env.local 이
# 실값째 추적된 적이 있어 그 이력은 새 저장소로 옮기며 지웠습니다(ADR-059 C). **다시 넣지 마세요.**


# ── 관계형 DB (Supabase Postgres · ap-northeast-2 서울) ──────────────
# ADR-016 이 서울 리전을 명시한 이유는 「데이터가 어디 있느냐」가 심사 질문이기 때문입니다.
#
# Supabase 대시보드 → Connect → Connection string 에서 가져옵니다.
# **둘이 다릅니다. 둘 다 필요합니다.**
#   · Transaction pooler (6543) — 앱이 씁니다. 서버리스는 연결이 짧게 많이 생겨 풀러가 필요합니다
#   · Session pooler (5432) — 마이그레이션이 씁니다. DDL 은 트랜잭션 풀러로 못 보냅니다
#
# ⚠️ DIRECT_URL 에 직접 연결(db.{ref}.supabase.co:5432)을 넣지 마세요. 그쪽은 **IPv6 전용**이라
#    IPv4 만 되는 환경(WSL 포함)에서 「Network is unreachable」로 실패합니다. 세션 풀러는
#    같은 세션을 유지해 DDL 이 통과하고 IPv4 로 붙습니다.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres


# ── Supabase (DB·Storage 공통) ──────────────────────────────────────
# 대시보드 → Project Settings → API Keys
# **Secret key** (sb_secret_…) 가 구 service_role 입니다 — Supabase 가 이름을 바꿨습니다.
# **이 키는 행 단위 접근 제어를 통과합니다.** 브라우저로 내보내지 마세요.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# **Publishable key** (sb_publishable_…, 구 anon). 지금은 쓰는 곳이 없습니다 —
# 브라우저가 Supabase 를 직접 부르지 않습니다.
SUPABASE_PUBLISHABLE_KEY=
# 토큰 검증용 공개키 주소. 아직 쓰는 곳이 없습니다 (로그인 체계가 없습니다 → ADR-021)
SUPABASE_JWKS_URL=


# ── 객체 저장소 (업로드 원본) ────────────────────────────────────────
# ⬜ 이름이 Vercel 제품 시절 것이라 어긋납니다 → 08-14-api.md §1.2 TODO.
#    볼트는 ADR-049 로 같은 Postgres 에 왔으니(볼트 전용 변수 없음) 남은 것은 이 이름 하나입니다 —
#    바꾸면 Vercel env 도 같은 커밋에 갈아야 합니다.
BLOB_TOKEN=


# ── 볼트 (복원 매핑 암호문) ──────────────────────────────────────────
# **환경변수가 없습니다.** 볼트는 위 Postgres 의 `vault` 스키마입니다 → ADR-049.
#
# 전에 있던 KV_URL·VAULT_MASTER_KEY 를 지웠습니다. 쓰는 코드가 하나도 없었고,
# 「VAULT_MASTER_KEY 가 노출되면 암호문이 전부 풀린다」는 설명도 사실이 아니었습니다 —
# 봉하는 것은 브라우저이고 서버 키로는 아무것도 못 엽니다 (ADR-009 · ADR-027).


# ── 언어모델 (Grok · xAI) ───────────────────────────────────────────
# OpenAI 호환 API 를 씁니다 (https://api.x.ai/v1) → 08-14-api.md §4
XAI_API_KEY=

# ── 다른 언어모델로 갈아끼우기 — 지금은 **비어 있습니다** (2026-08-28 부터 다시 xAI) ───
#
# lib/llm.ts 는 OpenAI 호환 /chat/completions 하나만 부릅니다. 아래 셋을 넣으면 그쪽으로
# 가고, 셋 다 비우면 위 xAI(grok-4.5)로 갑니다. 2026-08-25~27 은 xAI 크레딧이 없어(403)
# Gemini 무료 한도로 돌았고, 08-28 에 크레딧을 채우고 Vercel 에서 셋을 지웠습니다.
#
# ── xAI 모델을 재 봤습니다 (2026-08-28 · probe-llm.ts — 실제 프롬프트 · 인용 채점기) ──
#
#   grok-4.5                        ✅ 3/3 · 5~18초 · 근거가 없으면 「없다」고 선언합니다
#   grok-4.3                        ❌ 2/3 · 4~8초 · 근거 없다면서 인용을 붙임 → 앱에서 502
#   grok-4.20-0309-non-reasoning    ❌ 2/3 · 2~6초 · 근거 없는데 112 절차를 지어냄 (불변 규칙 1)
#   grok-4.6                        (안 잼) 12~14초 — 4.5 보다 느려 후보에서 뺐습니다
#
# 빠른 둘이 떨어진 자리가 바로 「LLM 은 절차를 창작하지 않는다」입니다. **LLM_MODEL 을
# 비워 두면 grok-4.5** 입니다. 프로덕션에서 챗 세 턴 걷기(qa_chat.py) 두 번: 2/3 → 3/3,
# 모델 호출 11~25초 — 한 번은 55초를 넘겨 503 이 났습니다(꼬리). 바꾸려면 아래로 3/3 을
# 먼저 확인하세요:
#   XAI_API_KEY=… npm run probe:llm -- --base https://api.x.ai/v1 --model <이름>
#
# ⚠️ 바꾸면 **토큰화된 사건 진술이 그 사업자에게 갑니다.** 개발·시연에 무엇을 쓸지는
#    사람이 정합니다 → CLAUDE.md 불변 규칙 2.
#
# **LLM_MODEL 은 쉼표로 여럿을 적을 수 있습니다** — 앞엣것이 막히면 뒤엣것으로 넘어갑니다.
# 제출본에서는 하나만 적으세요 — 모델이 다르면 답도 달라 재현이 안 됩니다.
#
# ── Gemini 를 재 봤던 것 (2026-08-25 · 지금은 안 씁니다) ─────────────────
#
# 챗 한 턴을 끝까지 돌려 **인용 검증까지 통과하는지**를 봤습니다.
# 「모델이 답했다」가 아니라 「우리 계약대로 답했다」가 기준입니다.
#
#   gemini-3-flash-preview  ✅ 10~16초 · 인용 정확 (preview 라 사라질 수 있음)
#   gemini-3.6-flash        ✅ 11~26초 · 인용 정확
#   gemini-3.7-flash        ✅ 21초    · 인용 정확
#   gemini-3.5-flash        ✅ 30초    · 인용 정확 (자주 503)
#   gemini-2.5-flash        ❌ KB_CITATION_MISSING
#                              ref 로 "history" 를 냅니다 — 프롬프트 안의 블록
#                              이름을 근거 번호로 착각합니다. 재시도 둘 다 같음
#   gemini-2.5-flash-lite   ❌ 404 (무료 키로 접근 불가)
#   gemini-2.5-pro          ❌ 404 (무료 키로 접근 불가)
#
# ⛔ **503 이 상시로 옵니다.** 어느 모델이 막히는지가 몇 분 만에 바뀝니다 —
#    한 번은 3.5·3.7 이 막혔고, 잠시 뒤엔 3-flash-preview 가 막혔습니다.
#    그래서 **쉼표로 여럿을 적습니다.** 앞엣것이 막히면 뒤엣것으로 넘어가고,
#    lib/llm.ts 가 예산(45초) 안에서 두 바퀴까지 돕니다.
#
# **모델을 바꾸면 다시 재세요.** 형식을 못 지키는 모델은 200 을 받고도
# 인용 검증에서 502 가 됩니다 — 그게 불변 규칙 1 이 작동하는 모습입니다.
#
#   npm run probe:llm -- --base <주소> --model <이름>
#
# DB·서버 없이 **모델만** 갈라 봅니다. 실제 prompt-builder 로 프롬프트를 짓고
# 실제 citation-checker 로 채점하므로, 여기서 통과하면 앱에서도 통과합니다.
# `--dry` 는 모델을 안 부르고 프롬프트 크기만 냅니다 — 한 턴이 얼마인지 볼 때.
#
# 10~30초가 걸리는 것은 thinking 이 켜져 있어서입니다. 타임아웃은 45초이고
# (lib/llm.ts) Vercel 함수 상한은 60초라 여유가 크지 않습니다.
#
# ── 안 재 본 것 ──────────────────────────────────────────────────────
# 아래는 **주소만 적어 둔 것이고 실제로 안 돌려봤습니다.**
#
# Groq          LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter    LLM_BASE_URL=https://openrouter.ai/api/v1   (모델 끝에 :free)
#
# ── 로컬(Ollama)을 재 봤습니다 — **GPU 없는 기기에서는 안 됩니다** (2026-08-26) ──
#
# 공짜라서 먼저 재 봤습니다. 떨어진 이유가 모델이 아니라 **하드웨어**입니다.
#
#   qwen3:4b    ❌ 세 케이스 전부 55초 초과
#                  thinking 이 켜져 있어 「1+1?」 에도 260 토큰을 씁니다
#   gemma3:4b   ❌ 세 케이스 전부 55초 초과 (thinking 은 없는데도)
#   gemma3:1b   ❌ 형식은 지키는데 **내용이 위험합니다**
#                  reply 로 프롬프트 안의 예시 문구를 그대로 베꼈고,
#                  KB 가 빈 케이스에서 없는 kb-2 를 인용했습니다 (unknown_ref)
#
# 원인: **GPU 가 없습니다.** ollama 가 내장그래픽을 버리고(dropping integrated
# GPU) 100% CPU 로 돕니다 — 4B·1B 모두 **6 tok/s**. 우리 답변 한 턴이
# 300~500 토큰이라 50~80초입니다. 예산 45초·Vercel 상한 60초를 못 맞춥니다.
#
# **되살리려면 GPU 가 붙은 곳이어야 합니다.** 모델을 더 줄이는 방향은 막다른
# 길입니다 — 1B 가 이미 근거를 지어냈습니다(불변 규칙 1·5·8).
#
# ── 한 턴이 얼마인가 (probe-llm.ts --dry, 2026-08-26) ────────────────
#
#   프롬프트 3,300~3,700자 = **약 1,800 토큰**  (KB 두 항목 기준. 늘면 커집니다)
#   답변                     약 300~500 토큰
#
# 유료로 갈 때의 어림 — **턴당 1원 안팎**입니다. 천 턴을 돌려도 천 원 대라,
# 개발 중 채팅을 많이 돌리는 것 자체는 부담이 아닙니다. 값은 바뀌니
# 붙이기 전에 사업자 요금표를 보세요.
# Gemini 로 갈 때 쓰던 값 (참고용 — 셋을 채우면 그쪽으로 갑니다):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.7-flash
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=


# ── 관리자 1계정 — 폐기 (2026-09-04 · ADR-068) ──────────────────────
# 관리자 조회 화면을 만들지 않기로 했습니다. 두 값은 비워 두세요 — 문지기(/api/admin/* → 401)는
# 값이 없어도 막고, 설정 현황에도 더 이상 뜨지 않습니다.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# 크론 엔드포인트 보호 → ADR-025. Vercel Cron 이 Bearer 로 보냅니다.
# **비어 있으면 무조건 막습니다** — 비교할 것이 없을 때 통과시키면 문이 열립니다.
CRON_SECRET=


# ── 매뉴얼 릴리스 ───────────────────────────────────────────────────
# 지금 쓰는 KB 릴리스 → ADR-045. **배포가 곧 릴리스입니다.**
# 비어 있으면 안내를 만들지 않고 멈춥니다 — 근거 없는 안내보다 낫습니다.
# 「가장 최근 적재분」을 쓰지 않습니다: 적재기가 검수 중인 다음 버전을 미리
# 올릴 수 있고, 그러면 아직 사람이 안 본 절차가 피해자에게 나갑니다.
KB_VERSION=


# ── 선택값 (없으면 기본값) ──────────────────────────────────────────
# 사건 보관 기간. 마지막 활동일 기준 → ADR-016
CASE_PURGE_DAYS=180
# 매뉴얼 수집 주기. 기본 하루 1회
KB_FETCH_CRON="0 3 * * *"

# ── 전사·판독 서비스 (services/transcriber) ────────────────────────────
# 모델을 서버리스 함수에 못 띄워 앱 밖에서 돕니다 → ADR-028
# 비면 녹음·캡처가 글로 안 옮겨집니다. **사건 진행은 그대로 돕니다**
# ⚠️ 밖에 열어 둘 때는 TOKEN 을 반드시 채우세요 — 그 서비스는 넘겨받은 주소를 내려받습니다
#
# 상시 서버는 오라클 애슈번 A1.Flex 에 떠 있습니다 — 주소·토큰은 소유자에게 받습니다.
# 공인 IP 는 예약(Reserved)이라 재시작해도 안 바뀝니다. Caddy 가 sslip.io 로 인증서를 받아 둡니다.
# 로컬에서 띄우려면 services/transcriber 에서
#   docker compose -f compose.local.yaml up -d --build
# 하고, URL 은 아래 기본값 그대로 · TOKEN 은 그때 띄운 것의 .env 에 있는 FINALLY_TOKEN 으로.
TRANSCRIBER_URL=http://127.0.0.1:8917
TRANSCRIBER_TOKEN=

# ── 2차 개인정보 탐지 (NER) ────────────────────────────────────────────
# 모델은 gemma3:4b 로 정해졌습니다 (docs/research/09 R-1 — 누출 0%·과차단 0%).
# 어디서 도는지는 ADR-043: 개발·데모는 RunPod Pod, **합성 데이터만 · 끝나면 terminate**.
#
# 비면 1차 정규식만 돕니다 — 계좌·주민번호·카드·전화는 잡히고 **이름이 안 걸립니다.**
# 그 사실은 응답의 nerApplied 와 설정 현황에 그대로 나옵니다.
#
# ⛔ **채웠는데 그 서비스가 안 뜨면 사건 진행이 멈춥니다.** STT·OCR 과 다릅니다 —
#    그쪽은 파일만 안 되고 절차는 나가는데, 이쪽은 **경계**라 못 가리면 안 내보냅니다.
#    걸어서 확인한 값(2026-08-27):
#
#      서비스 켜짐  PATCH …/slots/{key}  200  「김민수」 -> [이름-1]
#      서비스 꺼짐  PATCH …/slots/{key}  503  PII_TOKENIZER_UNAVAILABLE (retryable)
#
#    설계대로의 동작이지만, **주소만 넣고 서비스를 안 띄우는 상태를 만들지 마세요.**
#
# ⚠️ 이 주소가 곧 정책입니다. 이 자리는 **토큰화 이전**이라 원문이 그대로 지나갑니다
#    → ARCHITECTURE §6 · CLAUDE.md 불변 규칙 2. 원격 API 를 넣으면 경계가 그쪽으로
#    옮겨 갑니다. 밖에 열어 둘 때는 TOKEN 을 반드시 채우세요.
#
# 서비스가 갖출 것은 한 길뿐입니다 → spec/common/08-14-api.md §1.2 의 `/ner`
NER_URL=
NER_TOKEN=
NER_MODEL=gemma3:4b
# 한 발화를 얼마나 기다리나 (ms). 비면 12000.
#
# ⚠️ **12초는 GPU 기준입니다** — 09 §7 의 실측이 0.28초입니다. CPU 서버에 물리면
#    이 값이 곧 성패입니다. 2026-08-31 에 상시 서버(OCI A1.Flex · 2코어 ARM)로 재 보니
#    **한 발화에 10.7~12.3초**로 기본값을 절반쯤 넘겼습니다. 넘기면 503 이고,
#    그건 사건 진행이 멈춘다는 뜻입니다 → 09 §8.
#
#    CPU 서버에 붙일 거면 25000 쯤. **챗 라우트의 maxDuration(60초)보다 짧게.**
NER_TIMEOUT_MS=

# ── 시연 스위치 ───────────────────────────────────────────────────────
# 시작 화면의 「Mock 파일로 실행」 칩 — 합성 자료 셋을 한 번에 담는 자리(src/app/start/mock.ts).
# 실사용자 화면에는 안 보이는 것이 기본이고, `1` 이면 배포본에서도 보입니다 — **대회 기간에만.**
# `NEXT_PUBLIC_*` 은 빌드에 구워지므로 바꾸면 다시 배포해야 합니다(ADR-053). 주소에 `?demo` 를
# 붙이면 이 값과 무관하게 보이고, 로컬 dev 빌드는 늘 보입니다. 비밀값이 아닙니다.
NEXT_PUBLIC_DEMO_MOCK=

# ── 법령 수집 (kb-collector · 하루 1회 크론 /api/cron/kb-collect) ─────────
# 국가법령정보센터 Open API 의 사용자 ID(OC). 법제처 승인을 받은 ID 여야 합니다 —
# 승인 안 된 ID 면 API 가 JSON 대신 안내 페이지를 주고, 수집기는 그 소스를 「오류」로 남깁니다.
# 비어 있어도 앱은 그대로 돕니다. 매뉴얼(kb_entry)에는 절대 자동으로 쓰지 않습니다 → ADR-072 · RFC-002
LAW_API_OC=

# ── KB 조사 도구 (앱이 안 씁니다) ──────────────────────────────────────
# DART 전자공시 OpenAPI. `assets/datasets/08-26-org-dict/dart_lookup.py` 가 씁니다 —
# 기관 사전에 올릴 법인이 실재하는지, 홈페이지·업종이 무엇인지 확인하는 용도입니다.
# **런타임 코드는 이 값을 읽지 않습니다.** 비어 있어도 앱은 그대로 돕니다.
# 발급 — https://opendart.fss.or.kr/ (무료)
DART_API_KEY=

# RunPod. `deploy/runpod-pod.py`(시연 팟 · deploy/runpod-bench.md 「시연 당일 순서」)와
# `assets/datasets/08-26-stt-vad/mkpod.py`(벤치마크)가 Pod 를 띄울 때 씁니다 → ADR-043.
# **런타임 코드는 읽지 않고, Vercel 에도 없습니다.** 합성 데이터만 · 끝나면 terminate.
RUNPOD_API_KEY=
