# 이 파일을 .env 로 복사해서 채우세요. **.env 는 커밋하지 않습니다.**

# 앱이 이 서비스를 부를 때 쓰는 주소가 붙을 도메인.
# 셋 중 하나로 채웁니다:
#   1. 가진 도메인            transcriber.example.com
#   2. 도메인 없이 (무료)      1-2-3-4.sslip.io   ← 서버 공인 IP 의 점을 -로
#   3. Cloudflare Tunnel      아래 README 「도메인이 없을 때」
TRANSCRIBER_DOMAIN=

# 앱만 부를 수 있게 하는 공유 비밀. **비워 두지 마세요.**
#   openssl rand -hex 32
# 여기 넣은 값과 똑같은 값을 앱 쪽 TRANSCRIBER_TOKEN 에도 넣습니다
FINALLY_TOKEN=

# 전사 모델 크기. 실측이 medium 을 골랐습니다 → docs/research/09 §5.1
# base 는 숫자 20건 중 1~2건만 남겨 뒤 단계가 무너집니다
FINALLY_STT=medium

# 서비스가 쓸 수 있는 메모리 상한. 모델 둘이 2.3GB 를 붙듭니다.
#   메모리 4GB 서버 → 3g   ·   8GB 이상 → 6g
MEM_LIMIT=3g
