# /etc/finally/watch.env — 감시자의 비밀값. chmod 600 · 소유자 ubuntu. 저장소에 넣지 않습니다 (RFC-001 「deploy/」)
# 줄 끝 주석 금지 — systemd EnvironmentFile 은 '#' 뒤도 값으로 읽습니다
RUNPOD_API_KEY=
# 팟의 FINALLY_TOKEN 과 같은 값 — provision 이 팟에 넣습니다
TRANSCRIBER_TOKEN=
POD_SSH_KEY=/home/ubuntu/.ssh/id_ed25519_finally
# fine-grained PAT · 이 저장소 · Actions: Read and write 만.
# 비우면 주소 교체를 건너뛰고 메일로 알립니다(NOTIFY_TO 가 있을 때)
GITHUB_TOKEN=
GITHUB_REPO=Dojaegyum/fsec-ai-challenge
APP_ORIGIN=https://fin-ally-khaki.vercel.app
# 배포본과 같은 값 — /api/cron/evidence-resubmit 를 부릅니다
CRON_SECRET=
# Brevo
MAILER_API_KEY=
MAILER_FROM=
# 알림 받을 주소 — 비우면 메일은 하나도 안 나가고 로그로만 남습니다
NOTIFY_TO=
STATE_DIR=/var/lib/finally
# 시험용 — 감시할 팟 이름을 바꾼다
# WATCH_POD_NAME=finally-demo-shadow
# 시험용 — 배포본 주소 교체를 금지한다
# WATCH_NO_SWITCH=1
